# =============================================================================
# negocIA — Variables de entorno (desarrollo local)
# =============================================================================
# Cómo usar:
#   1. Copia este archivo a `.env` en la raíz del repositorio:
#        cp .env.example .env
#   2. Valores solo para desarrollo local. NUNCA commitees `.env`.
#
# Dónde se lee el archivo:
#   - apps/api ........ via @nestjs/config (ruta resuelta desde la raíz del repo)
#   - packages/database . via prisma.config.ts (misma ruta raíz)
#   - apps/web ......... via next.config.ts (carga el .env raíz y expone NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------

# =============================================================================
# API (apps/api)
# =============================================================================
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# Niveles: fatal | error | warn | info | debug
LOG_LEVEL=debug

# Orígenes permitidos por CORS en desarrollo (separados por coma)
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Auth (M-4) — apps/api
# =============================================================================
# Reglas de validación aplicadas por `validateEnv` (packages/config):
#   - JWT_SECRET: mínimo 32 BYTES (no caracteres) para HS256.
#     En producción es obligatoria; en local/test puede faltar.
#   - JWT_REFRESH_TTL_SECONDS debe ser mayor que JWT_ACCESS_TTL_SECONDS:
#     si no, un access token válido podría quedarse sin forma de renovarse.
#   - ARGON2_MEMORY_COST ≥ 8192 KiB (por debajo de 2^15, argon2id deja de
#     ser una defensa relevante).
#   - ARGON2_PARALLELISM no puede superar ARGON2_MEMORY_COST.
#
# Generar un secreto de desarrollo (32 bytes = 64 hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-64-caracteres-hex-generados-aleatoriamente

# Identidad del emisor/audiencia del access token. Se validan en cada verificación
# del JWT, así que un token de otro servicio no es aceptado aunque comparta secreto.
JWT_ISSUER=negocia-api
JWT_AUDIENCE=negocia-clients

# Vida del access token (segundos). 900 = 15 min.
JWT_ACCESS_TTL_SECONDS=900

# Vida del refresh token (segundos). 2592000 = 30 días.
# El refresh es opaco y se guarda hasheado (SHA-256), no es un JWT.
JWT_REFRESH_TTL_SECONDS=2592000

# Parámetros Argon2id (argon2 npm). memoryCost en KiB.
# 19456 KiB ≈ OWASP mínimo recomendado (19 MiB); timeCost 2 y parallelism 1
# dan ~50 ms por hash en hardware de escritorio.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# =============================================================================
# Email (F2-1) — apps/api
# =============================================================================
# Driver del canal de email, validado por `validateEnv`:
#   - `mock`: MockEmailAdapter (buffer en memoria; solo dev/test).
#   - `resend`: ResendEmailAdapter (SDK `resend`; producción).
# `mock` con NODE_ENV=production es error de arranque (el mock "envía" al vacío).
EMAIL_DRIVER=mock

# Solo obligatoria con EMAIL_DRIVER=resend. Generar una en https://resend.com
#RESEND_API_KEY=re_XXXXXXXX

# Remitente y base de los enlaces de acción del email.
EMAIL_FROM=no-reply@negocia.app
EMAIL_FROM_NAME=negocIA
APP_BASE_URL=http://localhost:3000

# =============================================================================
# Proveedor de IA (F3-3) — apps/api
# =============================================================================
# Driver del proveedor de IA, validado por `validateEnv`:
#   - `mock`: MockLlmAdapter (texto fijo + buffer en memoria; solo dev/test).
#   - `openrouter`: OpenRouterLlmAdapter (API de openrouter.ai; producción).
# `mock` con NODE_ENV=production es error de arranque: respondería a los
# clientes con un texto de pruebas.
LLM_DRIVER=mock

# Solo obligatoria con LLM_DRIVER=openrouter. Crear en https://openrouter.ai/keys
#OPENROUTER_API_KEY=sk-or-v1-XXXXXXXX

# Slug del modelo. En este proyecto se exige un modelo gratuito (`:free`) en
# OpenRouter para evitar costos por accidente. Ejemplos válidos:
#   apodex/apodex-1.1-mini:free
#   google/gemma-4-26b-a4b-it:free
#   inclusionai/ling-3.0-flash-sante:free
LLM_MODEL=apodex/apodex-1.1-mini:free

# Base de la API de chat (el adaptador añade /chat/completions).
# Cámbiala solo si apuntas a un proxy/relay propio compatible con OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Timeout por petición, en milisegundos.
LLM_TIMEOUT_MS=20000

# Atribución opcional en el ranking público de openrouter.ai. Si se dejan vacías,
# no se envían los headers HTTP-Referer / X-OpenRouter-Title.
#LLM_APP_URL=https://app.negocia.com
#LLM_APP_TITLE=negocIA

# =============================================================================
# Meta WhatsApp (F2-3/M8) — apps/api
# =============================================================================
# Driver del canal Meta, validado por `validateEnv`:
#   - `mock`: webhook en memoria (harness de tests; solo dev/test).
#   - `real`: valida la firma X-Hub-Signature-256 de Meta (producción).
# `mock` con NODE_ENV=production es error de arranque.
META_DRIVER=mock

# Valor arbitrario que configuras en tu app de Meta como "Verify Token"
# (`hub.verify_token` del GET /webhook). Mínimo 8 caracteres.
META_WEBHOOK_VERIFY_TOKEN=negocia-dev-verify-token

# App Secret de la app de Meta; firma el POST /webhook (HMAC-SHA256).
# Mínimo 16 caracteres. Revisar guard: una firma que no coincide → 401.
META_WEBHOOK_APP_SECRET=negocia-dev-app-secret-f2-3

# --- M9: Embedded Signup + Token largo (60d) ---
# Obtener en Meta Developer Console > Tu App > Settings > Basic
META_APP_ID=           # Ej: 1234567890123456
META_APP_SECRET=       # Ej: abcdef1234567890abcdef1234567890

# Callback URL para Embedded Signup (debe coincidir con la configurada en Meta)
# Ruta real del controller: /api/v1/whatsapp/accounts/embedded-signup/callback
# Usa tu túnel local (localtunnel/ngrok) + esa ruta.
META_EMBEDDED_SIGNUP_REDIRECT_URI=https://tu-tunel.local/api/v1/whatsapp/accounts/embedded-signup/callback

# --- M9.1: Cifrado access_token en BD (AES-256-GCM) ---
# OBLIGATORIA en todo entorno: CryptoService se construye siempre en
# DatabaseModule, así que una clave vacía impide el arranque.
# Solo desarrollo: genera la tuya antes de desplegar (32 bytes en base64 = 44 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=oZGey8v9c405EX2nKuzkyPPqNPHh8A7KpNKV7m5KF9Y=

# =============================================================================
# Scripts auxiliares (scripts/) — la API NO los lee
# =============================================================================
# El flujo normal NO usa tokens a mano: el access token lo emite Meta en el
# callback del Embedded Signup (META_EMBEDDED_SIGNUP_REDIRECT_URI), se guarda
# cifrado en whatsapp_accounts.access_token_encrypted y así lo consumen los
# envíos. NO pongas un token de API Setup en la BD.
#
# Solo los scripts manuales de prueba necesitan un token en el entorno; se
# ejecutan con:  node --env-file=.env scripts/<script>
# (test-auth.js y add-whatsapp-account.ts abortan si falta; simulate-inbound
# no lo necesita.)
#META_ACCESS_TOKEN=

# Destino de simulate-inbound.mjs (opcional; ya trae default local).
#API_URL=http://localhost:4000/api/v1/whatsapp/webhook

# =============================================================================
# Web (apps/web)
# =============================================================================
# Accesible desde el navegador. Apunta al prefijo global de la API (ver apps/api).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# =============================================================================
# Infraestructura (Docker Compose / PostgreSQL / Redis)
# =============================================================================
POSTGRES_DB=negocia
POSTGRES_USER=negocia
POSTGRES_PASSWORD=negocia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://negocia:negocia@localhost:5432/negocia?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Base de datos de TEST
# -----------------------------------------------------------------------------
# Los tests de integración y e2e usan un schema PostgreSQL AISLADO
# (`negocia_test`) en la misma instancia. Nunca `negocia`: los tests borran
# tablas entre casos y destruirían los datos locales.
#
# `migrate:deploy` global de los tests aplica el historial de migraciones
# sobre ese schema, de modo que los tests siempre corren contra la estructura
# que la producción espera.
TEST_DATABASE_URL=postgresql://negocia:negocia@localhost:5432/negocia?schema=negocia_test