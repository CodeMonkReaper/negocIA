# =============================================================================
# negocIA — Variables de entorno (desarrollo local)
# =============================================================================
# Cómo usar:
#   1. Copia este archivo a `.env` en la raíz del repositorio:
#        cp .env.example .env
#   2. Valores solo para desarrollo local. NUNCA commitees `.env`.
#
# Dónde se lee el archivo:
#   - apps/api ........ via @nestjs/config (ruta resuelta desde la raíz del repo)
#   - packages/database . via prisma.config.ts (misma ruta raíz)
#   - apps/web ......... via next.config.ts (carga el .env raíz y expone NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------

# =============================================================================
# API (apps/api)
# =============================================================================
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# Niveles: fatal | error | warn | info | debug
LOG_LEVEL=debug

# Orígenes permitidos por CORS en desarrollo (separados por coma)
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Web (apps/web)
# =============================================================================
# Accesible desde el navegador. Apunta al prefijo global de la API (ver apps/api).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# =============================================================================
# Infraestructura (Docker Compose / PostgreSQL / Redis)
# =============================================================================
POSTGRES_DB=negocia
POSTGRES_USER=negocia
POSTGRES_PASSWORD=negocia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://negocia:negocia@localhost:5432/negocia?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# =============================================================================
# Auth (M-4)
# =============================================================================
JWT_SECRET=tu-secreto-jwt-de-32-bytes-minimo
JWT_ISSUER=negocia-api
JWT_AUDIENCE=negocia-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Base de datos aislada para tests de integración y e2e
TEST_DATABASE_URL=postgresql://negocia:negocia@localhost:5432/negocia?schema=negocia_test

# =============================================================================
# Email (F2-1) — apps/api
# =============================================================================
# Driver del canal de email, validado por `validateEnv`:
#   - `mock`: MockEmailAdapter (buffer en memoria; solo dev/test).
#   - `resend`: ResendEmailAdapter (SDK `resend`; producción).
# `mock` con NODE_ENV=production es error de arranque.
EMAIL_DRIVER=mock

# Solo obligatoria con EMAIL_DRIVER=resend. Generar una en https://resend.com
# RESEND_API_KEY=re_XXXXXXXX

# Remitente y base de los enlaces de acción del email.
EMAIL_FROM=no-reply@negocia.app
EMAIL_FROM_NAME=negocIA
APP_BASE_URL=http://localhost:3000

# =============================================================================
# Proveedor de IA (F3-3) — apps/api
# =============================================================================
# Driver del proveedor: `mock` para pruebas; `openrouter` para producción real.
# El proyecto fuerza modelos gratuitos de OpenRouter para evitar cargos.
LLM_DRIVER=openrouter
LLM_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_API_KEY=sk-or-tu-api-key-de-openrouter-aqui
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=20000
LLM_APP_URL=http://localhost:4000
LLM_APP_TITLE=negocIA

# =============================================================================
# Meta WhatsApp (F2-3/M8) — apps/api
# =============================================================================
# Driver del canal Meta, validado por `validateEnv`:
#   - `mock`: webhook en memoria (harness de tests; solo dev/test).
#   - `real`: valida la firma X-Hub-Signature-256 de Meta (producción).
# `mock` con NODE_ENV=production es error de arranque.
META_DRIVER=real

# Valor arbitrario que configuras en tu app de Meta como "Verify Token"
# (`hub.verify_token` del GET /webhook). Mínimo 8 caracteres.
META_WEBHOOK_VERIFY_TOKEN=negocia-dev-verify-token

# App Secret de la app de Meta; firma el POST /webhook (HMAC-SHA256).
# Mínimo 16 caracteres. Revisar guard: una firma que no coincide → 401.
META_WEBHOOK_APP_SECRET=tu-app-secret-de-meta-aqui

# --- M8: Embedded Signup + Token largo (60d) ---
# Obtener en Meta Developer Console > Tu App > Settings > Basic
META_APP_ID=tu-meta-app-id-aqui
META_APP_SECRET=tu-meta-app-secret-aqui

# Callback URL para Embedded Signup (debe coincidir con la configurada en Meta)
# Ruta real del controller: /api/v1/whatsapp/accounts/embedded-signup/callback
# Usa tu túnel local (localtunnel/ngrok) + esa ruta.
META_EMBEDDED_SIGNUP_REDIRECT_URI=https://tu-url.ngrok-free.dev/api/v1/whatsapp/accounts/embedded-signup/callback
# --- M8.5.1: Cifrado access_token en BD (AES-256-GCM) ---
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 32 bytes en base64 = 44 chars
ENCRYPTION_KEY=generar-con-node-script-32-bytes-base64=
