# ==============================================================================
# negocIA — Variables de Entorno de Desarrollo Local
# Copia este archivo a .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Servidor API (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Web (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# Infraestructura Local (Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_DB=negocia
POSTGRES_USER=negocia
POSTGRES_PASSWORD=negocia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://negocia:negocia@localhost:5432/negocia?schema=public
TEST_DATABASE_URL=postgresql://negocia:negocia@localhost:5432/negocia_test?schema=negocia_test

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Seguridad & Autenticación (JWT & Argon2id)
# ------------------------------------------------------------------------------
# Clave HMAC-SHA256 (mínimo 32 bytes / 64 caracteres hex)
JWT_SECRET=6a1b9c3d8e2f4a7b5c0d1e2f3a4b5c6d7e8f0a1b2c3d4e5f6a7b8c9d0e1f2a3b
JWT_ISSUER=negocia-api
JWT_AUDIENCE=negocia-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Clave de cifrado simétrico AES-256-GCM para tokens de Meta (32 bytes base64)
# Generar una nueva: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ------------------------------------------------------------------------------
# Email Transaccional (Resend / Mock)
# ------------------------------------------------------------------------------
EMAIL_DRIVER=mock
RESEND_API_KEY=
EMAIL_FROM=no-reply@negocia.app
EMAIL_FROM_NAME=negocIA
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Motor de IA / LLM (OpenRouter / Mock)
# ------------------------------------------------------------------------------
LLM_DRIVER=mock
OPENROUTER_API_KEY=
LLM_MODEL=apodex/apodex-1.1-mini:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=20000
LLM_APP_URL=http://localhost:3000
LLM_APP_TITLE=negocIA

# ------------------------------------------------------------------------------
# WhatsApp Cloud API / Meta Webhooks (Real / Mock)
# ------------------------------------------------------------------------------
META_DRIVER=mock
META_WEBHOOK_VERIFY_TOKEN=negocia-dev-verify-token
META_WEBHOOK_APP_SECRET=negocia-dev-app-secret-f2-3
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_REDIRECT_URI=http://localhost:4000/api/v1/whatsapp/accounts/embedded-signup/callback
